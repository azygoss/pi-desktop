{
  "name": "pi-desktop",
  "productName": "Pi Desktop",
  "version": "0.11.1",
  "description": "Desktop GUI for the pi coding agent harness",
  "license": "MIT",
  "author": "Pi Desktop contributors",
  "type": "module",
  "main": "out/main/index.js",
  "packageManager": "pnpm@10.32.1",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:e2e": "electron-vite build && vitest run --config vitest.e2e.config.ts",
    "build:cua": "bash scripts/build-cua-helper.sh && bash scripts/build-dictation-helper.sh",
    "build:host": "vite build --config host.vite.config.ts",
    "pack:host": "node scripts/pack-host.mjs",
    "dist:dir": "pnpm build:cua && electron-vite build && electron-builder --dir",
    "dist:mac": "pnpm build:cua && electron-vite build && electron-builder --mac",
    "dist:mac:release": "APPLE_KEYCHAIN_PROFILE=${APPLE_KEYCHAIN_PROFILE:-pi-desktop-notary} pnpm dist:mac"
  },
  "dependencies": {
    "@earendil-works/pi-coding-agent": "0.85.1",
    "@fontsource/ibm-plex-mono": "5.3.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-webgl": "^0.19.0",
    "@xterm/xterm": "^6.0.0",
    "clsx": "2.1.1",
    "lucide-react": "1.47.0",
    "node-pty": "1.1.0",
    "qrcode": "1.5.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-markdown": "10.1.0",
    "remark-gfm": "4.0.1",
    "shiki": "4.4.3",
    "tweetnacl": "1.0.3",
    "ws": "8.22.0",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "24.13.6",
    "@types/qrcode": "1.5.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/ws": "8.18.2",
    "@vitejs/plugin-react": "5.2.0",
    "electron": "44.4.3",
    "electron-builder": "26.16.1",
    "electron-vite": "5.0.0",
    "eslint": "10.11.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-react-hooks": "7.1.1",
    "playwright-core": "1.63.0",
    "prettier": "3.9.8",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "typescript-eslint": "8.70.0",
    "vite": "7.3.6",
    "vitest": "5.0.1"
  },
  "optionalDependencies": {
    "@esbuild/darwin-x64": "0.28.1",
    "@mariozechner/clipboard-darwin-x64": "0.3.9"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "electron",
      "esbuild"
    ],
    "supportedArchitectures": {
      "os": [
        "darwin"
      ],
      "cpu": [
        "arm64",
        "x64"
      ]
    }
  }
}
